generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DeckTrend {
  up
  down
  stable
}

enum DeckZone {
  main
  extra
}

enum UserRole {
  USER
  EDITOR
  ADMIN
}

model User {
  id String @id @default(cuid())

  email String @unique

  username String @unique

  passwordHash String

  displayName String?

  avatarUrl String?

  /**
   * Orden preferido del catálogo: "rarity" | "name" | "level" | "attack".
   */
  defaultCardSort String @default("rarity")

  bio String?

  role UserRole @default(USER)

  decks Deck[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Card {
  id Int @id @default(autoincrement())

  ygoproId Int? @unique

  name String @unique

  slug String @unique

  /**
   * Formato del catálogo al que pertenece la carta.
   * Valores normalizados: "speed" | "rush".
   */
  format String @default("speed")

  obtain Json?

  type String

  attribute String?

  level Int?

  attack Int?

  defense Int?

  rarity String?

  /**
   * Estado en la banlist de Duel Links (Speed Duel).
   * Valores normalizados: "forbidden" | "limited1" | "limited2" | "limited3".
   */
  banlistStatus String?

  image String?

  description String?

  archetype String?

  race String?

  frameType String?

  scale Int?

  linkRating Int?

  linkMarkers Json?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deckCards DeckCard[]

  @@index([name])
  @@index([type])
  @@index([format])
  @@index([banlistStatus])
}

model SetMeta {
  slug String @id

  name String

  bannerUrl String?

  /// Fecha oficial de lanzamiento publicada por Duel Links Meta.
  /// Permite ordenar las expansiones por recencia real.
  releasedAt DateTime?

  @@index([name])
  @@index([releasedAt])
}

model Archetype {
  id String @id @default(cuid())

  name String

  slug String @unique

  image String?

  description String?

  decks Deck[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([slug])
}

model Deck {
  id String @id @default(cuid())

  name String

  slug String

  identifier String @unique @default(cuid())

  deckHash String @unique

  archetypeId String?

  archetype Archetype? @relation(fields: [archetypeId], references: [id])

  authorId String?

  author User? @relation(fields: [authorId], references: [id], onDelete: Cascade)

  isPublic Boolean @default(true)

  tier String?

  tierOrder Int @default(4)

  popularity Int @default(0)

  tournamentResults Int @default(0)

  trend DeckTrend @default(stable)

  format String @default("speed")

  description String?

  skill String?

  image String?

  wins Int @default(0)

  losses Int @default(0)

  cards DeckCard[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([tier])
  @@index([tierOrder])
  @@index([archetypeId])
  @@index([authorId])
  @@index([isPublic])
  @@index([popularity])
  @@index([tournamentResults])
}

/// Guía editorial independiente de las noticias.
/// El contenido se guarda como JSON estructurado para poder
/// editarlo desde Prisma Studio sin tocar el código.
model Guide {
  id String @id @default(cuid())

  slug String @unique

  title String

  summary String

  coverUrl String

  author String

  featured Boolean @default(false)

  content Json

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([featured])
  @@index([createdAt])
}

enum NewsCategory {
  UPDATES
  EVENTS
  BOXES
  BANLIST
}

/// Noticia editorial gestionable desde el panel de staff.
/// El contenido estructurado vive en JSON para conservar el
/// render actual (tags, cartas destacadas y secciones).
model NewsArticle {
  id String @id @default(cuid())

  slug String @unique

  title String

  summary String

  category NewsCategory

  coverUrl String

  author String

  content Json

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([createdAt])
}

/// Resultado de un torneo real. Los puestos se guardan como
/// JSON y pueden enlazar opcionalmente un Deck.id publicado.
model Tournament {
  id String @id @default(cuid())

  slug String @unique

  name String

  organizer String

  format String @default("Speed Duel")

  playerCount Int @default(0)

  date DateTime

  standings Json

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([organizer])
}

enum TierEntryFormat {
  SPEED
  RUSH
}

enum TierEntryTier {
  TIER_1
  TIER_2
  TIER_3
  HIGH_POTENTIAL
}

/// Arquetipo real de la Tier List competitiva. El staff lo
/// mantiene desde /tier-list conforme evoluciona el meta.
model TierEntry {
  id String @id @default(cuid())

  format TierEntryFormat @default(SPEED)

  tier TierEntryTier @default(TIER_1)

  archetype String

  cardName String?

  ygoproId Int?

  powerScore Int @default(0)

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([format, archetype])
  @@index([format])
  @@index([tier])
}

model DeckCard {
  id String @id @default(cuid())

  deckId String

  cardId Int

  quantity Int @default(1)

  zone DeckZone @default(main)

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  card Card @relation(fields: [cardId], references: [id])

  @@unique([deckId, cardId, zone])
  @@index([deckId])
  @@index([cardId])
}
