# Conexión a PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/cardmeta?schema=public"

# Secreto para firmar el JWT de sesión (mínimo 32 caracteres)
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# URL pública de la aplicación (se usa para construir el callback de Discord)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Discord OAuth2 (opcional)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Si se omite, se construye como ${NEXT_PUBLIC_APP_URL}/api/auth/discord/callback
DISCORD_REDIRECT_URI=""
